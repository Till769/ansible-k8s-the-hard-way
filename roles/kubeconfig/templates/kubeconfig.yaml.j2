apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/ca.crt', rstrip=false) | b64encode }}
    server: "{{ kc_server }}"
  name: "{{ cluster_name }}"
contexts:
- context:
    cluster: "{{ cluster_name }}"
    user: "{{ kc_user }}"
  name: "{{ kc_user }}@{{ cluster_name }}"
current-context: "{{ kc_user }}@{{ cluster_name }}"
kind: Config
preferences: {}
users:
- name: "{{ kc_user }}"
  user:
    client-certificate-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/' ~ kc_cert ~ '.crt', rstrip=false ) | b64encode }}
    client-key-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/' ~ kc_cert ~ '.key', rstrip=false ) | b64encode }}
